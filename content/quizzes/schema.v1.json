{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.tophealthinsider.com/schemas/quiz-funnel.v1.json",
  "title": "quiz funnel v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "description",
    "estimatedMinutes",
    "theme",
    "entrypoints",
    "results",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "quiz-funnel.v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 30
    },
    "theme": {
      "type": "object",
      "required": [
        "shell",
        "displayFont",
        "bodyFont",
        "canvasColor",
        "panelColor",
        "inkColor",
        "accentColor",
        "accentSoftColor",
        "edgeColor",
        "successColor"
      ]
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1
    },
    "results": {
      "type": "array",
      "minItems": 2
    },
    "steps": {
      "type": "array",
      "minItems": 3
    }
  }
}
